{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afp-pre-sensor-config-v1",
  "title": "AFP pre-sensor acquisition configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release_revision", "dataset_schema", "mode", "channels", "interfaces",
    "storage", "timeouts", "reconnect", "queues", "logging", "capacity"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "release_revision": {"type": "string", "minLength": 1},
    "dataset_schema": {"enum": ["new_collection_v13_0", "esr1001_raw_adc"]},
    "mode": {"enum": ["local_direct", "remote_helper"]},
    "channels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 77,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit", "interface_id"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "interface_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "driver", "location", "endpoint_ref"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "driver": {"type": "string", "minLength": 1},
          "location": {"enum": ["local", "remote_helper"]},
          "endpoint_ref": {"type": "string", "pattern": "^AFP_[A-Z0-9_]+$"},
          "baudrate": {"type": "integer", "minimum": 1200},
          "slave_id": {"type": "integer", "minimum": 1, "maximum": 247},
          "hardware_facts": {"type": "object"}
          ,"data_mode": {"enum": ["raw_adc", "microstrain"]}
          ,"calibration_profile": {"type": ["string", "object", "null"]}
          ,"bridge": {"type": "string"}
          ,"device_identity": {"type": "object"}
        }
      }
    },
    "helper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_url_ref", "pairing_profile_ref", "health_timeout_seconds", "command_timeout_seconds", "required_capabilities"],
      "properties": {
        "server_url_ref": {"type": "string", "pattern": "^AFP_[A-Z0-9_]+$"},
        "pairing_profile_ref": {"type": "string", "pattern": "^AFP_[A-Z0-9_]+$"},
        "health_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "command_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "required_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "storage": {"type": "object", "minProperties": 1},
    "timeouts": {"type": "object", "minProperties": 1},
    "reconnect": {"type": "object", "minProperties": 1},
    "queues": {"type": "object", "minProperties": 1},
    "logging": {"type": "object", "minProperties": 1},
    "capacity": {"type": "object", "minProperties": 1}
  },
  "oneOf": [
    {
      "properties": {"mode": {"const": "local_direct"}},
      "not": {"required": ["helper"]}
    },
    {
      "properties": {"mode": {"const": "remote_helper"}},
      "required": ["helper"]
    }
  ]
}
