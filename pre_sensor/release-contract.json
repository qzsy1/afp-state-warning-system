{
  "schema_version": 1,
  "identity": {
    "application_version": "2.0.5-rc.3",
    "helper_version": "2.0.5-rc.3",
    "launcher_version": "2.0.5-rc.3",
    "release_revision": "m3232-matrix-csv-v1"
  },
  "contracts": {
    "helper_protocol_version": 2,
    "unified_frame_contract": "unified_frame_v2",
    "configuration_schema_version": 1,
    "readiness_schema_version": 1
  },
  "static_assets": {
    "required": [
      "app/ui/index.html",
      "app/ui/app.js",
      "app/ui/curve_readiness.js",
      "app/ui/styles.css",
      "app/ui/mysql_visibility.js",
      "app/ui/process_parameters.js",
      "app/ui/public_demo.js",
      "app/ui/training.html",
      "app/ui/training.js"
    ]
  },
  "configuration_templates": {
    "required": [
      "config/pre_sensor/schema.json",
      "config/pre_sensor/local_direct.json",
      "config/pre_sensor/remote_helper.json"
    ]
  },
  "managed_files": {
    "manifest": "SHA256SUMS.txt",
    "digest_algorithm": "sha256",
    "managed_model_roots": [
      "models",
      "new_collection_demo_v11_3/models"
    ]
  },
  "runtime_requirements": {
    "python_runtime": "bundled",
    "required_modules": ["numpy", "pandas", "joblib", "mysql.connector", "serial"],
    "required_executables": [
      {"id": "local_capture_helper", "path": "local_helper/AFP_Local_Capture_Helper.exe"}
    ],
    "native_components": [
      {"id": "bsv_uvc", "path": "native_dll/BsvUvcNative.dll"},
      {"id": "libusb", "path": "native_dll/libusb-1.0.dll"}
    ],
    "vendor_sdks": [
      {
        "id": "bsv_uvc_sdk",
        "required_for": "uvc_temperature",
        "detection": "native_dll/BsvUvcNative.dll"
      }
    ],
    "drivers": [
      {"id": "huipu_tc64_modbus_rtu", "required_for": "thermocouple64", "release_gate": "protocol_readback_and_physical_acceptance_required"},
      {"id": "serial_port", "required_for": "m3232_pressure", "capabilities": ["m3232_uart_text_v1", "m3232_matrix_csv_v1"], "source_file": "app/legacy/m3232_serial.py"},
      {"id": "modbus_rtu_esr1001", "required_for": "esr1001_strain"},
      {"id": "esr1001_usb_ttl", "required_for": "esr1001_strain_usb", "capabilities": ["esr1001_raw_adc_capture", "esr1001_calibration_v1"], "source_file": "app/legacy/esr1001_usb.py"},
      {"id": "ethernet", "required_for": "plc_process_and_abb_motion"},
      {"id": "uvc", "required_for": "uvc_temperature"}
    ]
  }
}
