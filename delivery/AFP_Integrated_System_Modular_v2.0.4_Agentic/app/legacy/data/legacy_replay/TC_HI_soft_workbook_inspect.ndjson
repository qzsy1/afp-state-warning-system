{"kind":"table","sheet":"结论","address":"A1:H23","rows":23,"cols":8,"values":[["TC-HI软五层一致性状态预警（v13.8）",null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],["项目","结论",null,"层级","样本数","错误数","二分类平衡准确率","七状态准确率"],["方法","TC-HI + 软Potts/CRF对数意见池",null,"窗口",851,9,0.9884507649213532,0.9894242068155111],["分组交叉验证","未使用",null,"层",35,2,0.9666666666666667,0.9428571428571428],["硬试样标签回传","未使用",null,"试样",7,0,1,1],["参数选择","训练集拟合，验证集选择，测试集锁定",null,null,null,null,null,null],["所有锁定测试指标>90%",true,null,null,null,null,null,null],["7/7试样准确率Wilson 95%下限",0.6456695649333126,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],["术语说明与统计边界",null,null,null,null,null,null,null],["五层试样一致性约束：同一试样五层应共享工艺状态。旧方法把试样最终标签硬复制回每层和窗口；本版改为软概率一致性，窗口/层仍保留自身TC-HI证据。\n“一致性融合前局部平衡准确率”指尚未使用试样上下文时，仅凭当前窗口或层证据得到的二分类平衡准确率，BA=(异常召回率+正常召回率)/2；它不表示五层在统计学上相互独立。\n测试仅7个试样，七状态准确率每错1个下降14.29%；若要求>90%，只能7/7=100%。本次7/7的Wilson 95%下限仅64.6%，不能据此声称真实场景稳定100%。",null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,"层级","平衡准确率","七状态准确率",null,null],[null,null,null,"窗口",0.9884507649213532,0.9894242068155111,null,null],[null,null,null,"层",0.9666666666666667,0.9428571428571428,null,null],[null,null,null,"试样",1,1,null,null]]}