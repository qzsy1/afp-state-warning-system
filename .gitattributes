* text=auto
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.dll binary
*.exe binary
*.pth binary
*.joblib binary
*.npz binary

# The supported Windows delivery is versioned through Git LFS. Text source and
# configuration remain ordinary Git objects. Every delivery file keeps its
# exact assembled bytes so SHA256SUMS.txt remains valid after checkout.
delivery/AFP_Integrated_System_Modular_v2.0.4_Agentic/** -text
delivery/AFP_Integrated_System_Modular_v2.0.4_Agentic/**/*.exe filter=lfs diff=lfs merge=lfs -text
